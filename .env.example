# --- Infrastructure ---
DATABASE_URL=postgresql://pulse:pulse@localhost:5432/pulsequeue
REDIS_URL=redis://localhost:6379/0

# --- Worker ---
# Number of worker processes docker-compose starts (see `deploy.replicas`).
WORKER_CONCURRENCY=3
# Seconds BZPOPMIN blocks before the worker loops to check for shutdown/recovery.
DEQUEUE_TIMEOUT=1

# --- Retry policy (owned by RetryService) ---
MAX_RETRY_ATTEMPTS=3
BASE_RETRY_DELAY=2

# --- Crash recovery (owned by RecoveryService) ---
# A job left in RUNNING longer than this is presumed abandoned by a dead worker.
VISIBILITY_TIMEOUT=300
# How often a worker attempts the (Redis-lock-guarded) recovery sweep.
RECOVERY_INTERVAL=30

# --- Misc ---
LOG_LEVEL=INFO
