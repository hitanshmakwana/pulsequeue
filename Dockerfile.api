# --- PulseQueue API image ------------------------------------------------
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

RUN useradd --create-home --uid 1000 pulse && chown -R pulse:pulse /app

# Entrypoint: create the prometheus multiproc dir with correct ownership
# before dropping to the pulse user. The PROMETHEUS_MULTIPROC_DIR env var
# is set by docker-compose; the dir may not exist yet if this is a fresh volume.
COPY docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 8000

ENTRYPOINT ["/entrypoint.sh"]
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
