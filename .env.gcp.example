# --- GCP Environment Variables ---
# Copy this to .env.gcp and fill in your values.
# NEVER commit .env.gcp to git — it is in .gitignore.
#
# On the GCE VM, these are sourced by the deploy script before
# docker compose up. On a VM with a service account attached,
# GCP authentication is handled by Workload Identity (ADC) —
# no key file or GOOGLE_APPLICATION_CREDENTIALS needed.

# Your GCP project ID (not the project name).
# Find it: gcloud config get-value project
GCP_PROJECT_ID=your-gcp-project-id

# Pub/Sub resource names (created by infra/setup_gcp.sh)
PUBSUB_TOPIC=pulsequeue-jobs
PUBSUB_SUBSCRIPTION=pulsequeue-worker
PUBSUB_DLQ_TOPIC=pulsequeue-dlq

# --- Application overrides (same as .env.example) ---
# These are already set in docker-compose.gcp.yml via the Compose service
# environment block. Override here only if you need non-default values.

# WORKER_CONCURRENCY=3
# VISIBILITY_TIMEOUT=300
# RECOVERY_INTERVAL=30
# MAX_RETRY_ATTEMPTS=3
# BASE_RETRY_DELAY=2
# LOG_LEVEL=INFO
